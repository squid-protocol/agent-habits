    else:b=Board(); b.setfen(' '.join(a[2:8])); i=8
    if i<len(a) and a[i]=='moves':
     for z in a[i+1:]:
      fr,to,pr=z[:2],z[2:4],z[4:]; m=(sq(fr),sq(to),pr)
