#!/usr/bin/env python3
"""A small CDCL SAT solver for DIMACS CNF (DPLL with learning)."""

import heapq
import random
import sys


def read_dimacs(path):
    nvars = None
    expected = None
    clauses = []
    pending = []
    with open(path, "r", encoding="ascii", errors="strict") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("c"):
                continue
            if line.startswith("p"):
                parts = line.split()
                if len(parts) != 4 or parts[1] != "cnf":
                    raise ValueError("invalid DIMACS header")
                nvars, expected = int(parts[2]), int(parts[3])
                if nvars < 0 or expected < 0:
                    raise ValueError("negative DIMACS size")
                continue
            if nvars is None:
                raise ValueError("missing DIMACS header")
            for token in line.split():
                lit = int(token)
                if lit == 0:
                    clauses.append(pending)
                    pending = []
                else:
                    if abs(lit) > nvars:
                        raise ValueError("literal exceeds declared variable count")
                    pending.append(lit)
    if nvars is None or pending:
        raise ValueError("missing header or unterminated clause")
    if len(clauses) != expected:
        raise ValueError("clause count does not match header")
    return nvars, clauses


class Solver:
    def __init__(self, n, clauses):
        self.n = n
        self.clauses = []
        self.watches = {}
        self.assign = [-1] * (n + 1)
        self.level = [0] * (n + 1)
        self.reason = [-1] * (n + 1)
        self.phase = [1] * (n + 1)
        self.trail = []
        self.limits = []
        self.qhead = 0
        self.activity = [0.0] * (n + 1)
        self.var_inc = 1.0
        self.var_decay = 0.95
        self.heap = []
        self.conflicts = 0
        self.restart_at = 30
        self.restart_interval = 30
        self.restart_count = 0
        self.rng = random.Random()
        for v in range(1, n + 1):
            self.phase[v] = self.rng.randrange(2)
        for clause in clauses:
            # Repeated literals do not help propagation and complicate watches.
            c = list(dict.fromkeys(clause))
            if any(-x in c for x in c):
                continue
            ci = len(self.clauses)
            self.clauses.append(c)
            for lit in c:
                self.activity[abs(lit)] += 1.0
            if len(c) >= 2:
                self.watches.setdefault(c[0], []).append(ci)
                self.watches.setdefault(c[1], []).append(ci)
            elif len(c) == 1:
                self.watches.setdefault(c[0], []).append(ci)
        for v in range(1, n + 1):
            heapq.heappush(self.heap, (-self.activity[v], self.rng.random(), v))

    def value_lit(self, lit):
        val = self.assign[abs(lit)]
        if val < 0:
            return -1
        return val if lit > 0 else 1 - val

    def enqueue(self, lit, reason):
        v = abs(lit)
        val = 1 if lit > 0 else 0
        if self.assign[v] >= 0:
            return self.assign[v] == val
        self.assign[v] = val
        self.phase[v] = val
        self.level[v] = len(self.limits)
        self.reason[v] = reason
        self.trail.append(lit)
        return True

    def propagate(self):
        while self.qhead < len(self.trail):
            made_true = self.trail[self.qhead]
            self.qhead += 1
            false_lit = -made_true
            ws = self.watches.get(false_lit)
            if not ws:
                continue
            i = 0
            while i < len(ws):
                ci = ws[i]
                c = self.clauses[ci]
                if len(c) == 1:
                    if self.value_lit(c[0]) == 0:
                        return ci
                    i += 1
                    continue
                if c[0] == false_lit:
                    c[0], c[1] = c[1], c[0]
                # c[1] is the watched literal that just became false.
                if c[1] != false_lit:
                    # Stale watch entry should not occur, but discard safely.
                    ws[i] = ws[-1]
                    ws.pop()
                    continue
                other = c[0]
                if self.value_lit(other) == 1:
                    i += 1
                    continue
                replacement = -1
                for k in range(2, len(c)):
                    if self.value_lit(c[k]) != 0:
                        replacement = k
                        break
                if replacement >= 0:
                    c[1], c[replacement] = c[replacement], c[1]
                    self.watches.setdefault(c[1], []).append(ci)
                    ws[i] = ws[-1]
                    ws.pop()
                    continue
                if self.value_lit(other) == 0 or not self.enqueue(other, ci):
                    return ci
                i += 1
        return -1

    def bump(self, v):
        self.activity[v] += self.var_inc
        heapq.heappush(self.heap, (-self.activity[v], self.rng.random(), v))
        if self.activity[v] > 1e100:
            self.activity = [x * 1e-100 for x in self.activity]
            self.var_inc *= 1e-100

    def analyze(self, conflict):
        learned = [0]
        seen = [False] * (self.n + 1)
        path_count = 0
        p = 0
        ti = len(self.trail) - 1
        clause = self.clauses[conflict]
        current = len(self.limits)
        while True:
            for q in clause:
                v = abs(q)
                if q == p or seen[v] or self.level[v] == 0:
                    continue
                seen[v] = True
                self.bump(v)
                if self.level[v] == current:
                    path_count += 1
                else:
                    learned.append(q)
            while ti >= 0 and not seen[abs(self.trail[ti])]:
                ti -= 1
            if ti < 0:
                # Defensive fallback; a valid conflict graph always has a UIP.
                return [self.trail[-1]], max(0, current - 1)
            p = self.trail[ti]
            ti -= 1
            v = abs(p)
            seen[v] = False
            path_count -= 1
            if path_count == 0:
                break
            ri = self.reason[v]
            if ri < 0:
                clause = []
            else:
                clause = self.clauses[ri]
        learned[0] = -p
        back = 0
        if len(learned) > 1:
            best = 1
            for j in range(1, len(learned)):
                lv = self.level[abs(learned[j])]
                if lv > back:
                    back, best = lv, j
            learned[1], learned[best] = learned[best], learned[1]
        self.var_inc /= self.var_decay
        return learned, back

    def cancel_until(self, target):
        if len(self.limits) <= target:
            return
        cut = self.limits[target]
        for lit in reversed(self.trail[cut:]):
            v = abs(lit)
            self.assign[v] = -1
            self.reason[v] = -1
            self.level[v] = 0
            heapq.heappush(self.heap, (-self.activity[v], self.rng.random(), v))
        del self.trail[cut:]
        del self.limits[target:]
        self.qhead = min(self.qhead, len(self.trail))

    def choose(self):
        if self.n <= 300:
            remaining = [v for v in range(1, self.n + 1) if self.assign[v] < 0]
            if not remaining:
                return 0
            best = max(self.activity[v] for v in remaining)
            band = [v for v in remaining if self.activity[v] >= best * 0.97]
            return self.rng.choice(band)
        while self.heap:
            neg, _, v = heapq.heappop(self.heap)
            if self.assign[v] < 0:
                # Heap entries are lazy; old priorities are harmless, refresh if stale.
                if -neg + 1e-12 < self.activity[v]:
                    heapq.heappush(self.heap, (-self.activity[v], self.rng.random(), v))
                    continue
                return v
        for v in range(1, self.n + 1):
            if self.assign[v] < 0:
                return v
        return 0

    def solve(self):
        for ci, c in enumerate(self.clauses):
            if not c:
                return None
            if len(c) == 1 and not self.enqueue(c[0], ci):
                return None
        conflict = self.propagate()
        if conflict >= 0:
            return None
        while True:
            conflict = self.propagate()
            if conflict >= 0:
                self.conflicts += 1
                if len(self.limits) == 0:
                    return None
                learned, back = self.analyze(conflict)
                self.cancel_until(back)
                ci = len(self.clauses)
                self.clauses.append(learned)
                if len(learned) == 1:
                    self.watches.setdefault(learned[0], []).append(ci)
                else:
                    self.watches.setdefault(learned[0], []).append(ci)
                    self.watches.setdefault(learned[1], []).append(ci)
                self.enqueue(learned[0], ci)
                if self.conflicts >= self.restart_at:
                    self.cancel_until(0)
                    self.restart_count += 1
                    self.restart_interval = min(400, self.restart_interval * 3 // 2)
                    self.restart_at = self.conflicts + self.restart_interval
                    for var in range(1, self.n + 1):
                        self.phase[var] = self.rng.randrange(2)
                continue
            v = self.choose()
            if v == 0:
                return self.assign
            self.limits.append(len(self.trail))
            lit = v if self.phase[v] else -v
            self.enqueue(lit, -1)


def walksat(n, clauses, seconds=2.0):
    """Bounded stochastic model search; every returned assignment is checked."""
    import time
    if not clauses or n > 10000:
        return None

    rng = random.Random()
    occ = [[] for _ in range(n + 1)]
    for ci, c in enumerate(clauses):
        for lit in c:
            occ[abs(lit)].append(ci)
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        vals = [0] + [rng.randrange(2) for _ in range(n)]
        counts = []
        unsat = []
        pos = {}
        for ci, c in enumerate(clauses):
            count = sum((vals[abs(x)] == (1 if x > 0 else 0)) for x in c)
            counts.append(count)
            if count == 0:
                pos[ci] = len(unsat)
                unsat.append(ci)
        flips = 0
        while unsat and flips < 30000 and time.monotonic() < deadline:
            ci = rng.choice(unsat)
            c = clauses[ci]
            if rng.random() < 0.55:
                lit = rng.choice(c)
                v = abs(lit)
            else:
                scores = []
                best = None
                for lit in c:
                    v = abs(lit)
                    score = 0
                    for cj in occ[v]:
                        if counts[cj] == 1:
                            # This clause is broken if flipping v changes its sole true literal.
                            sole = next((x for x in clauses[cj] if vals[abs(x)] == (1 if x > 0 else 0)), 0)
                            if abs(sole) == v:
                                score += 1
                    if best is None or score < best:
                        best, scores = score, [v]
                    elif score == best:
                        scores.append(v)
                v = rng.choice(scores)
            old = vals[v]
            vals[v] = 1 - old
            for cj in occ[v]:
                c2 = clauses[cj]
                before = counts[cj]
                after = sum((vals[abs(x)] == (1 if x > 0 else 0)) for x in c2)
                counts[cj] = after
                if before == 0 and after > 0:
                    k = pos.pop(cj)
                    last = unsat.pop()
                    if k < len(unsat):
                        unsat[k] = last
                        pos[last] = k
                elif before > 0 and after == 0:
                    pos[cj] = len(unsat)
                    unsat.append(cj)
            flips += 1
        if not unsat and all(any(vals[abs(x)] == (1 if x > 0 else 0) for x in c) for c in clauses):
            return vals
    return None
def main():
    if len(sys.argv) != 2:
        print("usage: solver FILE", file=sys.stderr)
        return 1
    try:
        n, clauses = read_dimacs(sys.argv[1])
        model = walksat(n, clauses)
        if model is None:
            model = Solver(n, clauses).solve()
    except (OSError, ValueError) as e:
        print("c error:", e, file=sys.stderr)
        return 1
    if model is None:
        print("s UNSATISFIABLE")
        return 20
    print("s SATISFIABLE")
    vals = [str(v if model[v] == 1 else -v) for v in range(1, n + 1)]
    if vals:
        for i in range(0, len(vals), 20):
            print("v " + " ".join(vals[i:i + 20]) + (" 0" if i + 20 >= len(vals) else ""))
    else:
        print("v 0")
    return 10


if __name__ == "__main__":
    sys.exit(main())
