#!/usr/bin/env python3
"""A SAT solver for DIMACS CNF formulas.

The search is DPLL: unit propagation with two watched literals, backtracking
search and a decision heuristic. It is extended with conflict-driven clause
learning (first-UIP), VSIDS decisions, phase saving, Luby restarts and
LBD-based deletion of learnt clauses.

Usage: ./solver FILE

Output follows the SAT competition convention:
  s SATISFIABLE / v ... 0   and exit code 10
  s UNSATISFIABLE           and exit code 20
"""

import heapq
import sys

EXIT_SAT = 10
EXIT_UNSAT = 20


def parse_dimacs(path):
    """Return (number_of_variables, clauses); clauses are lists of non-zero ints."""
    header_vars = 0
    max_var = 0
    clauses = []
    current = []
    with open(path, "r", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            tag = line[0]
            if tag == "c":
                continue
            if tag == "%":  # end-of-formula marker used by some benchmark files
                break
            if tag == "p":
                parts = line.split()
                if len(parts) < 4 or parts[1] != "cnf":
                    raise ValueError("malformed problem line: %r" % line)
                header_vars = int(parts[2])
                continue
            for tok in line.split():
                lit = int(tok)
                if lit == 0:
                    clauses.append(current)
                    current = []
                else:
                    current.append(lit)
                    if abs(lit) > max_var:
                        max_var = abs(lit)
    if current:  # final clause without its terminating 0
        clauses.append(current)
    return max(header_vars, max_var), clauses


def luby(i):
    """The i-th term (i >= 1) of the Luby sequence 1, 1, 2, 1, 1, 2, 4, ..."""
    while True:
        k = 1
        while (1 << k) - 1 < i:
            k += 1
        if i == (1 << k) - 1:
            return 1 << (k - 1)
        i -= (1 << (k - 1)) - 1


# Literal encoding: variable v (1..n) gives literal 2*v (positive) and 2*v+1 (negative).
# Negation is lit ^ 1. value[lit] is 1 if lit is true, -1 if false, 0 if unassigned.

def solve(n, formula):
    """Decide the formula. Returns a model as a list of signed ints, or None if UNSAT."""
    nlit = 2 * n + 2
    value = [0] * nlit
    level = [0] * (n + 1)
    reason = [None] * (n + 1)
    phase = [0] * (n + 1)  # saved polarity: 1 = last assigned positive, 0 = negative
    activity = [0.0] * (n + 1)
    seen = [0] * (n + 1)
    watches = [[] for _ in range(nlit)]  # watches[lit]: clauses watching lit
    trail = []
    trail_lim = []  # trail_lim[d]: trail length when decision level d+1 started
    clauses = []
    learnts = []
    lbd = {}  # id(learnt clause) -> literal block distance
    qhead = 0
    var_inc = 1.0
    heap = [(0.0, v) for v in range(1, n + 1)]  # max-heap on activity (lazy entries)
    heapq.heapify(heap)

    def enqueue(lit, why):
        v = lit >> 1
        value[lit] = 1
        value[lit ^ 1] = -1
        level[v] = len(trail_lim)
        reason[v] = why
        trail.append(lit)

    def propagate():
        """Unit propagation. Returns a conflicting clause, or None at a fixpoint."""
        nonlocal qhead
        while qhead < len(trail):
            p = trail[qhead]
            qhead += 1
            fl = p ^ 1  # literal that just became false
            ws = watches[fl]
            i = j = 0
            m = len(ws)
            while i < m:
                c = ws[i]
                i += 1
                if c[0] == fl:
                    c[0] = c[1]
                    c[1] = fl
                first = c[0]
                if value[first] == 1:  # clause satisfied, keep watching
                    ws[j] = c
                    j += 1
                    continue
                for k in range(2, len(c)):
                    lit = c[k]
                    if value[lit] != -1:  # found a replacement watch
                        c[1] = lit
                        c[k] = fl
                        watches[lit].append(c)
                        break
                else:
                    ws[j] = c
                    j += 1
                    if value[first] == -1:  # conflict
                        while i < m:
                            ws[j] = ws[i]
                            j += 1
                            i += 1
                        del ws[j:]
                        return c
                    # unit clause: imply its first literal (inlined enqueue)
                    value[first] = 1
                    value[first ^ 1] = -1
                    v = first >> 1
                    level[v] = len(trail_lim)
                    reason[v] = c
                    trail.append(first)
            del ws[j:]
        return None

    def backtrack(lvl):
        nonlocal qhead
        if len(trail_lim) <= lvl:
            return
        lim = trail_lim[lvl]
        for k in range(len(trail) - 1, lim - 1, -1):
            lit = trail[k]
            v = lit >> 1
            value[lit] = 0
            value[lit ^ 1] = 0
            phase[v] = 1 - (lit & 1)
            reason[v] = None
            heapq.heappush(heap, (-activity[v], v))
        del trail[lim:]
        del trail_lim[lvl:]
        qhead = len(trail)

    def analyze(confl):
        """First-UIP conflict analysis. Returns (learnt clause, backtrack level, LBD)."""
        nonlocal var_inc
        cur = len(trail_lim)
        learnt = [0]  # slot 0 is reserved for the asserting literal
        path = 0  # number of seen literals at the current decision level
        idx = len(trail) - 1
        c = confl
        start = 0
        while True:
            for k in range(start, len(c)):
                q = c[k]
                v = q >> 1
                if not seen[v] and level[v] > 0:
                    seen[v] = 1
                    activity[v] += var_inc
                    if activity[v] > 1e100:
                        for u in range(1, n + 1):
                            activity[u] *= 1e-100
                        var_inc *= 1e-100
                        heap[:] = [(-activity[u], u) for u in range(1, n + 1) if value[2 * u] == 0]
                        heapq.heapify(heap)
                    if level[v] >= cur:
                        path += 1
                    else:
                        learnt.append(q)
            while True:  # walk the trail back to the next seen literal
                p = trail[idx]
                idx -= 1
                if seen[p >> 1]:
                    break
            v = p >> 1
            seen[v] = 0
            path -= 1
            if path == 0:
                break
            c = reason[v]  # reason clauses keep the implied literal in slot 0
            start = 1
        learnt[0] = p ^ 1

        # Local minimisation: drop a literal whose reason is covered by the clause.
        to_clear = learnt[1:]
        keep = [learnt[0]]
        for q in to_clear:
            r = reason[q >> 1]
            redundant = r is not None
            if redundant:
                for x in r[1:]:
                    if not seen[x >> 1] and level[x >> 1] > 0:
                        redundant = False
                        break
            if not redundant:
                keep.append(q)
        for q in to_clear:
            seen[q >> 1] = 0

        if len(keep) == 1:
            bt = 0
        else:
            best = 1
            for k in range(2, len(keep)):
                if level[keep[k] >> 1] > level[keep[best] >> 1]:
                    best = k
            keep[1], keep[best] = keep[best], keep[1]
            bt = level[keep[1] >> 1]
        glue = len({level[q >> 1] for q in keep})
        return keep, bt, glue

    def clean(c):
        """At level 0: False if c is satisfied (to be dropped); otherwise remove false literals."""
        for lit in c:
            if value[lit] == 1:
                return False
        c[:] = [lit for lit in c if value[lit] != -1]
        return True

    def reduce_db():
        """At level 0: simplify the clause database and delete half of the learnt clauses."""
        for lit in trail:
            reason[lit >> 1] = None
        clauses[:] = [c for c in clauses if clean(c)]
        learnts.sort(key=lambda c: (lbd[id(c)], len(c)))
        half = len(learnts) // 2
        survivors = []
        for k, c in enumerate(learnts):
            if (k < half or lbd[id(c)] <= 2) and clean(c):
                survivors.append(c)
            else:
                lbd.pop(id(c), None)
        learnts[:] = survivors
        for w in watches:
            w.clear()
        for c in clauses:
            watches[c[0]].append(c)
            watches[c[1]].append(c)
        for c in learnts:
            watches[c[0]].append(c)
            watches[c[1]].append(c)

    # Load the formula: drop tautologies and duplicate literals, enqueue unit clauses.
    for lits in formula:
        codes = set()
        for x in lits:
            codes.add(2 * x if x > 0 else -2 * x + 1)
        if any((code ^ 1) in codes for code in codes):
            continue
        codes = list(codes)
        if not codes:
            return None  # empty clause
        if len(codes) == 1:
            code = codes[0]
            if value[code] == -1:
                return None
            if value[code] == 0:
                enqueue(code, None)
        else:
            clauses.append(codes)
            watches[codes[0]].append(codes)
            watches[codes[1]].append(codes)

    conflicts = 0
    since_restart = 0
    restart_count = 1
    restart_limit = 100 * luby(restart_count)
    reduce_at = 2000
    reduce_count = 0
    need_reduce = False

    while True:
        confl = propagate()
        if confl is not None:
            if not trail_lim:
                return None  # conflict at decision level 0
            conflicts += 1
            since_restart += 1
            learnt, bt, glue = analyze(confl)
            backtrack(bt)
            if len(learnt) == 1:
                enqueue(learnt[0], None)
            else:
                learnts.append(learnt)
                lbd[id(learnt)] = glue
                watches[learnt[0]].append(learnt)
                watches[learnt[1]].append(learnt)
                enqueue(learnt[0], learnt)
            var_inc *= 1.0 / 0.95
            if conflicts >= reduce_at:
                need_reduce = True
        else:
            if since_restart >= restart_limit:
                backtrack(0)
                since_restart = 0
                restart_count += 1
                restart_limit = 100 * luby(restart_count)
                if need_reduce:
                    reduce_db()
                    need_reduce = False
                    reduce_count += 1
                    reduce_at = conflicts + 2000 + 300 * reduce_count
                if len(heap) > 4 * n + 100:
                    heap[:] = [(-activity[u], u) for u in range(1, n + 1) if value[2 * u] == 0]
                    heapq.heapify(heap)
                continue
            # Decision: the unassigned variable with the highest activity.
            var = 0
            while heap:
                _, cand = heapq.heappop(heap)
                if value[2 * cand] == 0:
                    var = cand
                    break
            if var == 0:
                return [v if value[2 * v] == 1 else -v for v in range(1, n + 1)]
            trail_lim.append(len(trail))
            enqueue(2 * var if phase[var] else 2 * var + 1, None)


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("usage: solver FILE\n")
        return 1
    n, formula = parse_dimacs(argv[1])
    model = solve(n, formula)
    if model is None:
        sys.stdout.write("s UNSATISFIABLE\n")
        return EXIT_UNSAT

    # Never report a model that does not satisfy the input.
    assign = {abs(lit): lit > 0 for lit in model}
    for c in formula:
        if not any(assign.get(abs(lit)) == (lit > 0) for lit in c):
            sys.stderr.write("internal error: model does not satisfy the formula\n")
            return 1

    tokens = [str(lit) for lit in model] + ["0"]
    out = ["s SATISFIABLE"]
    for i in range(0, len(tokens), 20):
        out.append("v " + " ".join(tokens[i:i + 20]))
    sys.stdout.write("\n".join(out) + "\n")
    return EXIT_SAT


if __name__ == "__main__":
    sys.exit(main(sys.argv))
